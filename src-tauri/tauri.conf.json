{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tanglaw Bible",
  "version": "0.7.0",
  "identifier": "org.tanglaw.bible",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "title": "Tanglaw Bible", "width": 1200, "height": 820, "minWidth": 360, "minHeight": 480, "decorations": false }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "category": "Education",
    "shortDescription": "Offline Bible study with theWord and e-Sword modules",
    "copyright": "Tanglaw Bible"
  }
}
